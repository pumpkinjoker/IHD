# Copy to .env.local. Never put real credentials in this example or NEXT_PUBLIC_*.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Optional bot user ID (U...) used to check webhook destination.
LINE_BOT_USER_ID=
LINE_INTAKE_ENABLED=false
# local = on-disk PostgreSQL + photos, for running on this computer only.
# remote = Supabase + Google Drive, requiring the credentials below.
LINE_STORAGE_MODE=remote
# Optional independent overrides: media can be local, supabase (private test bucket), or drive.
LINE_DATABASE_MODE=supabase
LINE_MEDIA_MODE=supabase
# Optional absolute folder override when running locally (never use on Vercel).
IHD_LOCAL_DATA_DIR=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth authorization for the team's My Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_EMPLOYEES_SPREADSHEET_ID=
